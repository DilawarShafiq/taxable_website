# ===== Firebase (client-side — safe to expose) =====
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=taxable-ai-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=taxable-ai-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=taxable-ai-2026.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ===== Firebase Admin (server-side only) =====
# On Cloud Run: uses Application Default Credentials (no key needed)
# Local dev: paste service account JSON (one line) or set GOOGLE_APPLICATION_CREDENTIALS path
FIREBASE_SERVICE_ACCOUNT_KEY=

# ===== Cloud SQL PostgreSQL =====
# Cloud Run (Unix socket via Cloud SQL proxy):
INSTANCE_UNIX_SOCKET=/cloudsql/taxable-ai-2026:us-central1:taxable-ai-db
DB_NAME=taxable_ai
DB_USER=postgres
DB_PASS=your-db-password
# Local dev (TCP):
DATABASE_URL=postgresql://postgres:your-db-password@34.122.204.241:5432/taxable_ai?sslmode=require

# ===== Google Cloud / Vertex AI =====
ANTHROPIC_VERTEX_PROJECT_ID=taxable-ai-2026
CLOUD_ML_REGION=us-east5
# Local dev only — Cloud Run uses Workload Identity:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ===== Google Cloud Storage =====
GCS_BUCKET=taxable-ai-documents

# ===== Email (Gmail / Google Workspace) =====
# Create an App Password at: myaccount.google.com/apppasswords (needs 2FA enabled)
# For Google Workspace: use your workspace email (e.g. noreply@taxable.ai)
GMAIL_USER=noreply@taxable.ai
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_LEADS_EMAIL=leads@taxable.ai

# ===== Financial Data APIs =====
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
COINGECKO_API_KEY=
FRED_API_KEY=your-fred-api-key

# ===== MCP Server URLs =====
MCP_TAX_RULES_URL=http://localhost:3001
MCP_MARKET_DATA_URL=http://localhost:3002
MCP_DOCUMENTS_URL=http://localhost:3003

# ===== App =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_ASSET_DASHBOARD=true
